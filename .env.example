# Mandatory
DB_URL=jdbc:postgresql://database:5432/papertrail
DB_USERNAME=postgres
DB_PASSWORD=yourpassword
REDIS_URL=redis://default:password@cache:6379

# Optional
PORT=<defaults_to_8080>
MANAGEMENT_PORT=<defaults_to_9000>
LOG_LEVEL=<defaults_to_INFO><available-options:OFF,FATAL,ERROR,WARN,INFO,DEBUG,TRACE,ALL>